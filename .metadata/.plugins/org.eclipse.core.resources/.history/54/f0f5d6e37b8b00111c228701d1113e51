server:
    port: 8080

spring:
    application:
        name: api-gateway

    cloud:
        gateway:
            server:
                webflux:
                    routes:
                        # Route 1: Auth Service
                        - id: auth-service
                          uri: lb://AUTH-SERVICE
                          predicates:
                              - Path=/api/v1/auth/**

                        # Route 2: Order Service
                        - id: order-service
                          uri: lb://ORDER-SERVICE
                          predicates:
                              - Path=/api/v1/orders/**

                        # Route 3: Payment Service
                        - id: payment-service
                          uri: lb://PAYMENT-SERVICE
                          predicates:
                              - Path=/api/v1/payments/**

eureka:
    client:
        service-url:
            defaultZone: http://localhost:8761/eureka/
